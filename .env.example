# Choose ONE auth method:

# Option 1: Anthropic API key (pay-per-use)
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Option 2: leave ANTHROPIC_API_KEY blank and run `claude login` on the host
# (uses your Claude Pro/Max subscription via the Claude Code CLI)

# Optional: passwords for Windows hosts referenced in inventory
WIN_PASSWORD=
